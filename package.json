{
  "name": "threema-web",
  "version": "2.6.5",
  "description": "Threema Webclient",
  "scripts": {
    "build": "bun run build:js && bun run build:css",
    "build:js": "webpack --config webpack.prod.js",
    "build:css": "sass --silence-deprecation=import --style=compressed src/sass/:public/css/",
    "build:css:watch": "sass --silence-deprecation=import --watch --poll --style=compressed --source-map --embed-source-map src/sass/:public/css/",
    "build:tests": "echo -e 'NOTE: Use either \"bun run build:unittests\" or \"bun run build:uitests\"\n' && exit 1",
    "build:unittests": "webpack --config webpack.tests.js",
    "build:uitests": "bun run build:css && webpack --config webpack.tests.js",
    "dist": "bun run clean && bun run build && echo \"\" && bun dist/build-package.js",
    "serve:live": "echo 'NOTE: serve:live command has been renamed to devserver'",
    "devserver": "bun run build:css && bunx webpack-dev-server --config webpack.dev.js",
    "testserver": "bunx webpack-dev-server --config webpack.tests.js",
    "test": "echo -e 'NOTE: Use either \"bun run test:unit\" or \"bun run test:ui\"\n' && exit 1",
    "test:unit": "bun run build:unittests && karma start --single-run --log-level=debug --colors",
    "test:ui": "bash tests/ui/run.sh",
    "lint": "bun run lint:ts",
    "lint:ts": "tslint -c tslint.json --project tsconfig.json --exclude \"**/src/config.ts\"",
    "clean": "rm -rf dist/generated"
  },
  "keywords": [
    "threema",
    "saltyrtc",
    "webrtc",
    "messenger"
  ],
  "author": "Threema GmbH",
  "license": "AGPL-3.0+",
  "private": true,
  "homepage": "https://threema.com/",
  "dependencies": {
    "@babel/core": "^7.18.10",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.18.10",
    "@babel/preset-env": "^7.18.10",
    "@babel/runtime": "^7.18.9",
    "@saltyrtc/client": "^0.15.1",
    "@saltyrtc/task-relayed-data": "^0.4.0",
    "@saltyrtc/task-webrtc": "^0.15.0",
    "@threema/compose-area": "^0.4.6",
    "@threema/threema-markup": "^1.1.0",
    "@types/angular": "^1.8.4",
    "@types/angular-material": "^1.1.73",
    "@types/angular-sanitize": "^1.8.1",
    "@types/angular-translate": "^2.19.0",
    "@types/file-saver": "^2.0.5",
    "@types/jquery": "^3.5.14",
    "@types/msgpack-lite": "^0.1.8",
    "@types/webrtc": "0.0.33",
    "@uirouter/angularjs": "^1.0.30",
    "angular": "^1.8.3",
    "angular-animate": "^1.8.3",
    "angular-aria": "^1.8.3",
    "angular-material": "=1.2.5",
    "angular-messages": "^1.8.3",
    "angular-route": "^1.8.3",
    "angular-sanitize": "^1.8.3",
    "angular-translate": "^2.19.0",
    "angularjs-scroll-glue": "=2.1.0",
    "autolinker": "~4.0.0",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.24.1",
    "croppie": "^2.6.5",
    "emojibase-regex": "^4.1.1",
    "file-saver": "^2.0.5",
    "messageformat": "^2.3.0",
    "msgpack-lite": "~0.1.26",
    "qrcode-generator": "^1.4.4",
    "sass": "^1.77.0",
    "scrypt-js": "^3.0.1",
    "sdp": "~3.2.0",
    "setimmediate": "^1.0.5",
    "ts-events": "^3.4.1",
    "ts-loader": "^9.5.4",
    "ts-log": "^2.2.4",
    "tweetnacl": "^1.0.3",
    "twemoji": "^12.1.6",
    "typescript": "~5.1.6",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "webrtc-adapter": "^8.1.2"
  },
  "devDependencies": {
    "@types/chai": "^4.3.3",
    "@types/jasmine": "^4.0.3",
    "@types/selenium-webdriver": "^4.1.2",
    "angular-mocks": "^1.8.3",
    "chai": "^4.3.6",
    "concurrently": "^9.0.1",
    "css-loader": "^7.1.4",
    "geckodriver": "^4.0.5",
    "jasmine": "^3.99.0",
    "jasmine-core": "^3.99.1",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.1.1",
    "karma-firefox-launcher": "^2.1.2",
    "karma-jasmine": "^4.0.2",
    "sass-loader": "^17.0.0",
    "selenium-webdriver": "^4.4.0",
    "style-loader": "^4.0.0",
    "ts-node": "~10.9.1",
    "tslint": "^6.1.3",
    "webpack-dev-server": "^5.2.2"
  },
  "overrides": {
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
